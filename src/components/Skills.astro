---
// Skills.astro
---

<section id="habilidades" class="skills-premium">
            <div class="container">
                <span class="eyebrow reveal-top">MY TOOLKIT</span>
                <h2 class="section-title reveal-top">HABILIDADES <span class="italic">&amp; TECH STACK</span></h2>

                <div class="skills-grid">
                    <div class="skill-category reveal-left">
                        <div class="category-header">
                            <div class="icon-box">✦</div>
                            <h3>UX / UI &amp; Diseño</h3>
                        </div>
                        <ul class="skill-list">
                            <li><span>Diseño de interfaces (UI)</span><div class="progress-bar"><div class="progress" style="width: 95%"></div></div></li>
                            <li><span>Experiencia de usuario (UX)</span><div class="progress-bar"><div class="progress" style="width: 90%"></div></div></li>
                            <li><span>Diseño de interacción</span><div class="progress-bar"><div class="progress" style="width: 85%"></div></div></li>
                            <li><span>Design Systems</span><div class="progress-bar"><div class="progress" style="width: 80%"></div></div></li>
                            <li><span>Responsive Design</span><div class="progress-bar"><div class="progress" style="width: 95%"></div></div></li>
                        </ul>
                    </div>

                    <div class="skill-category highlight-card reveal-bottom">
                        <div class="category-header">
                            <div class="icon-box">&lt;&gt;</div>
                            <h3>Desarrollo Web</h3>
                        </div>
                        <div class="tech-tags">
                            <span class="tag">HTML</span>
                            <span class="tag">CSS / Tailwind CSS</span>
                            <span class="tag">JavaScript</span>
                            <span class="tag">PHP</span>
                            <span class="tag">Laravel</span>
                            <span class="tag">MySQL</span>
                            <span class="tag">Git</span>
                        </div>
                        <p class="category-desc">Especializada en crear puentes sólidos entre el diseño visual y la lógica del servidor.</p>
                    </div>

                    <div class="skill-category reveal-right">
                        <div class="category-header">
                            <div class="icon-box">⚙</div>
                            <h3>Herramientas</h3>
                        </div>
                        <div class="tools-grid">
                            <div class="tool-item"><span>Figma</span></div>
                            <div class="tool-item"><span>Illustrator</span></div>
                            <div class="tool-item"><span>Photoshop</span></div>
                            <div class="tool-item"><span>VS Code</span></div>
                            <div class="tool-item"><span>GitHub</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
